# ==========================================
# Supabase Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (NEVER expose to the browser; used only in protected server-side scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL for auth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Expo Push Service Configuration
# ==========================================
# Server-side Expo Access Token (Bearer auth for push delivery & receipt validation)
# NEVER prefix with NEXT_PUBLIC_ or commit actual tokens to source control
EXPO_ACCESS_TOKEN=your-expo-access-token-here
