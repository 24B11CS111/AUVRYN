# Root environment template for Multi-Institution Education Management Platform
# Configure with your isolated Staging or Production credentials.
# NEVER commit actual secrets or service role keys to version control.

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mobile Client Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Expo Push Service Server Token (Server-only; for push notifications dispatch)
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# Notification & Cron Secrets
# CRON_SECRET is required to authenticate Vercel Cron (/api/cron/daily)
# and external schedulers (e.g. GitHub Actions / cron-job.org hitting /api/cron/notifications)
CRON_SECRET=your-random-cron-secret-here
HRIX_PLATFORM_ADMIN_EMAILS=admin@auvryn.internal
